{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "GDP per capita (PPP, 2021), adapted from the session 4 choropleth in the Economics Observatory data visualisation masterclass",
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/world/world.json",
    "format": {"type": "topojson", "feature": "geog"}
  },
  "config": {"view": {"stroke": "transparent"}},
  "width": "container",
  "height": "container",
  "transform": [
    {
      "lookup": "properties.adm0_a3",
      "from": {
        "key": "ISO3",
        "fields": ["country", "value"],
        "data": {
          "url": "https://raw.githubusercontent.com/EconomicsObservatory/courses/main/datasets/advanced/global_gdp_perCapita_2021.csv"
        }
      }
    }
  ],
  "projection": {"type": "naturalEarth1"},
  "mark": {"type": "geoshape", "stroke": "#F6EFEC", "strokeWidth": 0.3},
  "encoding": {
    "color": {
      "condition": {"test": "!datum.value", "value": "#d8d2cf"},
      "field": "value",
      "type": "quantitative",
      "scale": {"type": "log", "scheme": "viridis"},
      "legend": null
    },
    "tooltip": [
      {"field": "properties.name", "title": "Country"},
      {"field": "value", "title": "GDP per capita (PPP)", "format": "$,d"}
    ]
  }
}
