{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Step 3. Match the FT's plot size, start in 1950, centre one bar on each year and strip back the axes.",
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/jhellingsdata.github.io/main/Data/ONS_UK_housebuilding_long.csv"
  },
  "transform": [{"filter": "utcyear(datum.Period) >= 1950"}],
  "width": 649,
  "height": 389,
  "config": {"view": {"stroke": "transparent"}},
  "mark": {"type": "bar", "width": {"band": 0.85}, "binSpacing": 0},
  "encoding": {
    "x": {
      "field": "Period",
      "type": "temporal",
      "timeUnit": "utcyear",
      "bandPosition": 0,
      "title": null,
      "axis": {
        "grid": false,
        "tickCount": {"interval": "year", "step": 10},
        "domainColor": "#999189",
        "tickColor": "#999189",
        "tickSize": 7
      }
    },
    "y": {
      "field": "Completed",
      "type": "quantitative",
      "title": null,
      "scale": {"domain": [0, 440000], "nice": false},
      "axis": {
        "gridColor": "#ccc1b7",
        "domain": false,
        "ticks": false,
        "labelPadding": 7,
        "tickCount": 5,
        "labelExpr": "datum.value / 1000"
      }
    },
    "color": {"field": "Sector", "type": "nominal"}
  }
}
