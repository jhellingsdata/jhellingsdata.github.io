{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Step 6. Turn the chart into a layered spec and add the dashed target line and its label.",
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/jhellingsdata.github.io/main/Data/ONS_UK_housebuilding_long.csv"
  },
  "transform": [
    {"filter": "utcyear(datum.Period) >= 1950"},
    {
      "calculate": "indexof(['Private enterprise', 'Housing associations', 'Local authorities'], datum.Sector)",
      "as": "SectorOrder"
    }
  ],
  "width": 649,
  "height": 389,
  "background": "#fff1e5",
  "config": {"view": {"stroke": "transparent"}, "axis": {"labelColor": "#4d4845"}},
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": {"band": 0.85},
        "binSpacing": 0,
        "opacity": 0.9,
        "fillOpacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "temporal",
          "timeUnit": "utcyear",
          "bandPosition": 0,
          "title": null,
          "axis": {
            "grid": false,
            "tickCount": {"interval": "year", "step": 10},
            "domainColor": "#999189",
            "tickColor": "#999189"
          }
        },
        "y": {
          "field": "Completed",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 440000], "nice": false},
          "axis": {
            "gridColor": "#ccc1b7",
            "domain": false,
            "ticks": false,
            "labelPadding": 5,
            "tickCount": 5,
            "labelExpr": "datum.value / 1000"
          }
        },
        "color": {
          "field": "Sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Private enterprise",
              "Housing associations",
              "Local authorities"
            ],
            "range": ["#0f5499", "#70dce6", "#ef6590"]
          },
          "legend": {
            "orient": "top",
            "direction": "vertical",
            "title": null,
            "symbolType": "M-1.5,-1H1.5V1H-1.5Z",
            "symbolSize": 120,
            "labelFontSize": 16,
            "labelColor": "#33302e"
          }
        },
        "order": {"field": "SectorOrder", "type": "quantitative"}
      }
    },
    {
      "data": {"values": [{"target": 300000}]},
      "encoding": {"y": {"field": "target", "type": "quantitative"}},
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [6, 4],
            "strokeWidth": 2.2,
            "color": "#33302e"
          }
        },
        {
          "mark": {
            "type": "text",
            "text": ["Labour", "target"],
            "x": {"expr": "width / 2"},
            "dy": -30,
            "lineHeight": 17,
            "fontSize": 14.4,
            "fontWeight": 600,
            "color": "#33302e"
          }
        }
      ]
    }
  ]
}
