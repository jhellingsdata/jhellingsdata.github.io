{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Step 9. Finishing touches: thin gaps between stacked segments and a tooltip.",
  "title": {
    "text": "The UK has not built 300,000 homes a year since 1977",
    "subtitle": "Completed dwellings (000)",
    "anchor": "start",
    "offset": 16,
    "fontSize": 21,
    "fontWeight": "normal",
    "color": "#33302e",
    "subtitleFontSize": 16,
    "subtitleColor": "#4d4845",
    "subtitlePadding": 6
  },
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/jhellingsdata.github.io/main/Data/ONS_UK_housebuilding_long.csv"
  },
  "transform": [
    {"filter": "utcyear(datum.Period) >= 1950"},
    {
      "calculate": "indexof(['Private enterprise', 'Housing associations', 'Local authorities'], datum.Sector)",
      "as": "SectorOrder"
    }
  ],
  "width": 649,
  "height": 389,
  "background": "#fff1e5",
  "padding": 16,
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Hanken Grotesk, Arial, sans-serif",
    "axis": {"labelColor": "#4d4845", "labelFontSize": 14.4}
  },
  "layer": [
    {
      "data": {"values": [{"start": "2019-07-01", "end": "2022-07-01"}]},
      "mark": {"type": "rect", "color": "#ccc1b7", "opacity": 0.5},
      "encoding": {"x": {"field": "start", "type": "temporal"}, "x2": {"field": "end"}}
    },
    {
      "mark": {
        "type": "bar",
        "width": {"band": 0.95},
        "binSpacing": 0,
        "opacity": 0.9,
        "fillOpacity": 0.9,
        "stroke": "#fff1e5",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "temporal",
          "timeUnit": "utcyear",
          "bandPosition": 0,
          "title": null,
          "axis": {
            "grid": false,
            "tickCount": {"interval": "year", "step": 10},
            "domainColor": "#999189",
            "tickColor": "#999189"
          }
        },
        "y": {
          "field": "Completed",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 440000], "nice": false},
          "axis": {
            "gridColor": "#ccc1b7",
            "domain": false,
            "ticks": false,
            "labelPadding": 5,
            "tickCount": 5,
            "labelExpr": "datum.value / 1000"
          }
        },
        "color": {
          "field": "Sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Private enterprise",
              "Housing associations",
              "Local authorities"
            ],
            "range": ["#0f5499", "#70dce6", "#ef6590"]
          },
          "legend": {
            "orient": "none",
            "legendX": -29,
            "legendY": -75,
            "direction": "vertical",
            "title": null,
            "symbolType": "M-1.5,-1H1.5V1H-1.5Z",
            "symbolSize": 120,
            "labelFontSize": 16,
            "labelColor": "#33302e",
            "rowPadding": 0
          }
        },
        "order": {"field": "SectorOrder", "type": "quantitative"},
        "tooltip": [
          {
            "field": "Period",
            "type": "temporal",
            "timeUnit": "utcyear",
            "title": "Year"
          },
          {"field": "Sector", "type": "nominal"},
          {"field": "Completed", "type": "quantitative", "format": ","}
        ]
      }
    },
    {
      "data": {"values": [{"target": 300000}]},
      "encoding": {"y": {"field": "target", "type": "quantitative"}},
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [6, 4],
            "strokeWidth": 2.2,
            "color": "#33302e"
          }
        },
        {
          "mark": {
            "type": "text",
            "text": ["Labour", "target"],
            "x": {"expr": "width / 2"},
            "dy": -30,
            "lineHeight": 17,
            "fontSize": 14.4,
            "fontWeight": 600,
            "color": "#33302e"
          }
        }
      ]
    },
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "text",
        "text": [
          "Recreated from an FT chart",
          "Source: ONS • Covid affected data collection between 2020 and 2022"
        ],
        "x": -29,
        "y": {"expr": "height + 40"},
        "align": "left",
        "baseline": "top",
        "lineHeight": 17,
        "fontSize": 13,
        "color": "#4d4845"
      }
    }
  ]
}
